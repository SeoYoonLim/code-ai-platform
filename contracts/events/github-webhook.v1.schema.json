{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.codeai.local/events/github-webhook.v1.schema.json",
  "title": "GitHubWebhookDelivery",
  "description": "POST /v1/webhooks/github 로 수신하는 GitHub 웹훅 1건 (헤더 + 본문). Backend가 사용하는 필드만 정의하며 나머지 필드는 허용·무시한다. 처리 규칙은 contracts/events/README.md. ★ Claude 소유.",
  "type": "object",
  "required": ["headers", "payload"],
  "properties": {
    "headers": { "$ref": "#/$defs/DeliveryHeaders" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "headers": { "properties": { "x-github-event": { "const": "push" } } } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/PushPayload" } } }
    },
    {
      "if": { "properties": { "headers": { "properties": { "x-github-event": { "const": "ping" } } } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/PingPayload" } } }
    }
  ],
  "$defs": {
    "Sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "NullSha": { "type": "string", "const": "0000000000000000000000000000000000000000", "description": "브랜치 생성/삭제 시 before/after 값" },

    "DeliveryHeaders": {
      "type": "object",
      "description": "헤더명은 소문자로 정규화",
      "required": ["x-github-event", "x-github-delivery", "x-hub-signature-256"],
      "properties": {
        "x-github-event": { "type": "string", "examples": ["push", "ping"] },
        "x-github-delivery": { "type": "string", "format": "uuid", "description": "중복 제거 키 (Redis 24h)" },
        "x-hub-signature-256": { "type": "string", "pattern": "^sha256=[0-9a-f]{64}$" },
        "x-github-hook-id": { "type": "string" }
      }
    },

    "Repository": {
      "type": "object",
      "required": ["id", "full_name", "clone_url", "default_branch"],
      "properties": {
        "id": { "type": "integer", "description": "프로젝트 매칭 1순위 키 (full_name은 rename 가능)" },
        "full_name": { "type": "string", "examples": ["octo/app"] },
        "clone_url": { "type": "string", "pattern": "^https://" },
        "html_url": { "type": "string" },
        "default_branch": { "type": "string" },
        "private": { "type": "boolean" }
      }
    },

    "Commit": {
      "type": "object",
      "required": ["id", "timestamp", "added", "modified", "removed"],
      "properties": {
        "id": { "$ref": "#/$defs/Sha" },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "added": { "type": "array", "items": { "type": "string" } },
        "modified": { "type": "array", "items": { "type": "string" } },
        "removed": { "type": "array", "items": { "type": "string" } }
      }
    },

    "PushPayload": {
      "type": "object",
      "description": "commits는 GitHub가 최대 20개만 보내므로 파일 목록은 참고용이다. 변경 판별은 Engine의 content_hash 비교(data-flow §3.3)가 기준.",
      "required": ["ref", "before", "after", "created", "deleted", "forced", "repository", "commits"],
      "properties": {
        "ref": { "type": "string", "pattern": "^refs/(heads|tags)/.+$" },
        "before": { "anyOf": [{ "$ref": "#/$defs/Sha" }, { "$ref": "#/$defs/NullSha" }] },
        "after": { "anyOf": [{ "$ref": "#/$defs/Sha" }, { "$ref": "#/$defs/NullSha" }] },
        "created": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "forced": { "type": "boolean", "description": "true면 incremental 대신 full 재색인" },
        "repository": { "$ref": "#/$defs/Repository" },
        "commits": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/Commit" } },
        "head_commit": { "anyOf": [{ "$ref": "#/$defs/Commit" }, { "type": "null" }] },
        "sender": {
          "type": "object",
          "properties": { "login": { "type": "string" } }
        }
      }
    },

    "PingPayload": {
      "type": "object",
      "description": "웹훅 등록 직후 1회 전송. 서명 검증 후 202 ignored(reason=ping) 응답.",
      "required": ["zen", "hook_id"],
      "properties": {
        "zen": { "type": "string" },
        "hook_id": { "type": "integer" },
        "hook": {
          "type": "object",
          "properties": { "events": { "type": "array", "items": { "type": "string" } } }
        },
        "repository": { "$ref": "#/$defs/Repository" }
      }
    },

    "IgnoreReason": {
      "type": "string",
      "description": "WebhookAck.reason 값 (backend.v1.yaml)",
      "enum": ["ping", "unsupported_event", "unknown_repository", "non_default_branch", "tag_push", "branch_deleted"]
    }
  }
}
