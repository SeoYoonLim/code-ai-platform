# 복사해서 .env 로 사용 (커밋 금지)

# --- AI Engine ---
ENGINE_LLM_PROVIDER=llamacpp          # llamacpp | fake  (ADR-0003: Ollama는 임베딩 전용)
ENGINE_LLAMACPP_URL=http://localhost:8080
# ENGINE_LLAMACPP_API_KEY=
# LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:<verified RepoDigest>
ENGINE_OLLAMA_URL=http://localhost:11434
ENGINE_VLLM_URL=http://localhost:8200/v1
ENGINE_BASE_MODEL=qwen2.5-coder-7b-instruct-q4_k_m   # llama-server가 로드하는 base GGUF (ADR-0003 v2). 14B는 후보
ENGINE_NUM_CTX=16384                # 슬롯당 컨텍스트 = LLAMA_CTX / LLAMA_PARALLEL (32768 / 2)
ENGINE_NUM_CTX_MAX=16384
ENGINE_EMBED_DEVICE_POLICY=gpu      # dynamic | gpu | cpu. 16GB에서는 항상 GPU (ADR-0003 v2)
# LLAMA_MODEL=qwen2.5-coder-7b-instruct-q4_k_m.gguf   # infra/llama/entrypoint.sh 입력
# LLAMA_CTX=32768                   # 전체 컨텍스트(슬롯 수로 나뉨)
# LLAMA_PARALLEL=2
ENGINE_EMBED_MODEL=nomic-embed-text
ENGINE_CHROMA_URL=http://localhost:8001
ENGINE_REGISTRY_PATH=ml/registry/adapters.json
ENGINE_INTERNAL_TOKEN=change-me

# --- Backend ---
BACKEND_ENGINE_URL=http://localhost:8100
BACKEND_ENGINE_TOKEN=change-me
BACKEND_DATABASE_URL=postgresql+asyncpg://codeai:codeai@localhost:5432/codeai
BACKEND_REDIS_URL=redis://localhost:6379/0
BACKEND_REPOS_DIR=./.data/repos
BACKEND_JWT_SECRET=change-me
BACKEND_GITHUB_WEBHOOK_SECRET=change-me
BACKEND_FCM_CREDENTIALS_PATH=
